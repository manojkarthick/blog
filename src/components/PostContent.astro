---
import { cn, formatDate } from "../lib/utils";

interface Props {
  title: string;
  date: Date;
  updates?: { date: Date; note?: string }[];
}

const { title, date, updates = [] } = Astro.props;

const sortedUpdates = [...updates].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
);
const lastUpdated = sortedUpdates[0]?.date;
const notedUpdates = sortedUpdates.filter((update) => update.note);
const hasTimeline = notedUpdates.length > 0;
const UpdatedTag = hasTimeline ? "a" : "span";

const timelineItem =
  "relative grid gap-0.5 pb-5 pl-6 last:pb-0 before:absolute before:top-[0.45em] before:left-0 before:size-[9px] before:rounded-full before:border-[1.5px] before:border-zinc-500 before:bg-white first:before:bg-zinc-500 after:absolute after:top-[calc(0.45em+13px)] after:bottom-[calc(4px-0.45em)] after:left-1 after:w-px after:bg-zinc-300 last:after:hidden dark:before:bg-zinc-900 dark:first:before:bg-zinc-500 dark:after:bg-zinc-700";
---

<main>
  <h1 class="mb-5 text-xl font-medium">
    {title}
  </h1>
  <p class="mb-1 font-medium text-zinc-500">
    <time datetime={date.toISOString()} class="whitespace-nowrap">
      {formatDate(date)}
    </time>
    {
      lastUpdated && (
        <>
          {" · "}
          <UpdatedTag
            href={hasTimeline ? "#updates" : undefined}
            class={cn(
              "font-normal whitespace-nowrap",
              hasTimeline &&
                "underline decoration-zinc-400 decoration-dotted underline-offset-3 hover:text-zinc-900 dark:decoration-zinc-600 dark:hover:text-zinc-200",
            )}
          >
            Last updated{" "}
            <time datetime={lastUpdated.toISOString()}>
              {formatDate(lastUpdated)}
            </time>
          </UpdatedTag>
        </>
      )
    }
  </p>
  <article>
    <slot />
  </article>
  {
    hasTimeline && (
      <section aria-labelledby="updates">
        <h2 id="updates" class="mt-8 mb-4 text-lg font-medium dark:text-white">
          Updates
        </h2>
        <ol>
          {notedUpdates.map((update) => (
            <li class={timelineItem}>
              <time
                datetime={update.date.toISOString()}
                class="font-medium text-zinc-500"
              >
                {formatDate(update.date)}
              </time>
              <span class="leading-relaxed">{update.note}</span>
            </li>
          ))}
          <li class={timelineItem}>
            <time
              datetime={date.toISOString()}
              class="font-medium text-zinc-500"
            >
              {formatDate(date)}
            </time>
            <span class="text-zinc-500">Published</span>
          </li>
        </ol>
      </section>
    )
  }
</main>
